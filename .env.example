# ============================================
# DJANGO BACKEND CONFIGURATION
# ============================================

# Secret key for Django (change in production!)
DJANGO_SECRET_KEY=your-secret-key-change-in-production

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=heuriskein_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Or use DATABASE_URL format (uncomment if using this)
# DATABASE_URL=postgresql://postgres:postgres@db:5432/heuriskein_db

# ============================================
# CACHE & MESSAGE BROKER
# ============================================

# Redis
REDIS_URL=redis://redis:6379/0

# ============================================
# LLM API KEYS
# ============================================

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# OpenAI API
OPENAI_API_KEY=sk-xxxxxxxxxxxxx

# ============================================
# FRONTEND CONFIGURATION
# ============================================

# API Server
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1

# WebSocket Server
NEXT_PUBLIC_WS_URL=ws://localhost:8001/ws

# ============================================
# ENVIRONMENT & DEPLOYMENT
# ============================================

# Environment: development, staging, production
ENVIRONMENT=development

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000
